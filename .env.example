OPENAI_API_KEY=
TAVILY_API_KEY=

# Application cache settings
CHATBOT_CACHE_ENABLED=true
CHATBOT_CACHE_MAX_ENTRIES=256
RAG_CACHE_TTL_SECONDS=900
WEB_CACHE_TTL_SECONDS=300
RAG_CACHE_NAMESPACE=faiss-default-v1
WEB_CACHE_NAMESPACE=tavily-default-v1

# Automatic model-routing settings
MODEL_ROUTER_MODEL=gpt-4o-mini
MODEL_FAST=gpt-4o-mini
MODEL_STANDARD=gpt-4o
MODEL_ADVANCED=gpt-4o
MODEL_COMPLEX_QUESTION_CHARS=300
MODEL_LARGE_CONTEXT_CHARS=12000

# Cost optimization and token budgets
COST_HISTORY_TOKEN_BUDGET=1500
COST_RAG_TOKEN_BUDGET=5000
COST_WEB_TOKEN_BUDGET=4000
COST_FINAL_MAX_OUTPUT_TOKENS=600
COST_ROUTER_MAX_OUTPUT_TOKENS=32

# USD per one million tokens; update if provider pricing changes
PRICE_GPT4O_MINI_INPUT_PER_M=0.15
PRICE_GPT4O_MINI_OUTPUT_PER_M=0.60
PRICE_GPT4O_INPUT_PER_M=2.50
PRICE_GPT4O_OUTPUT_PER_M=10.00

# Rotating operational debug logs
OPERATIONAL_LOG_LEVEL=INFO
OPERATIONAL_LOG_FILE=logs/chatbot_debug.jsonl
OPERATIONAL_LOG_MAX_BYTES=5000000
OPERATIONAL_LOG_BACKUP_COUNT=5

# Deployment health probe
CHATBOT_HEALTH_HOST=127.0.0.1
CHATBOT_HEALTH_TIMEOUT_SECONDS=5

# FastAPI configuration
API_TITLE=Intelligent Knowledge Assistant API
API_VERSION=1.0.0
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# API chatbot defaults
CHATBOT_DEFAULT_MODEL=Automatic
CHATBOT_DEFAULT_TEMPERATURE=0
CHATBOT_MAX_HISTORY_MESSAGES=6

# FastAPI URL used by the Streamlit frontend
CHATBOT_API_BASE_URL=http://localhost:8000
CHATBOT_API_TIMEOUT_SECONDS=120
CHATBOT_API_AUTH_MODE=none

# Demo UI login. Keep enabled locally; disable only for a public frontend.
STREAMLIT_LOGIN_ENABLED=true

# For a Streamlit service on Cloud Run calling a private FastAPI service:
# CHATBOT_API_BASE_URL=https://YOUR-FASTAPI-SERVICE-URL.run.app
# CHATBOT_API_AUTH_MODE=google
# CHATBOT_API_AUDIENCE=https://YOUR-FASTAPI-SERVICE-URL.run.app
